{
  "version": "1.1",
  "description": "MaskClaw 端侧隐私规则种子库；规则只描述策略，不包含真实个人数据。",
  "rules": [
    {
      "rule_id": "pii.phone.external",
      "name": "手机号发给外部接收方",
      "description": "手机号属于直接身份标识，向陌生人、公开群聊或第三方应用展示时仅保留必要片段，其余局部打码。",
      "action": "MASK",
      "pii_types": ["phone", "手机号", "电话号码"],
      "recipients": ["陌生人", "外部", "公开群", "第三方", "unknown"],
      "sensitivities": ["high", "直接身份标识"],
      "priority": 90
    },
    {
      "rule_id": "pii.phone.user_requested_send",
      "name": "用户明确发送自己的手机号",
      "description": "用户明确要求把自己的手机号发送给已确认联系人时，可允许发送；仍应保留审计记录。",
      "action": "ALLOW",
      "pii_types": ["phone", "手机号"],
      "task_intents": ["发送给已确认联系人", "本人联系方式"],
      "recipients": ["已确认联系人", "本人"],
      "priority": 86
    },
    {
      "rule_id": "pii.phone.ambiguous",
      "name": "手机号用途或接收方不明确",
      "description": "手机号检测到但任务没有说明用途或接收方时，先询问用户，不得凭相似度自动放行。",
      "action": "ASK",
      "pii_types": ["phone", "手机号"],
      "recipients": ["unknown"],
      "priority": 88
    },
    {
      "rule_id": "pii.id_card",
      "name": "身份证件号码",
      "description": "身份证号、护照号、驾驶证号等政府签发证件标识默认局部打码；只有明确的本地政务办理任务才进入确认。",
      "action": "MASK",
      "pii_types": ["id_card", "身份证号", "护照号", "驾驶证号"],
      "sensitivities": ["critical", "高敏感"],
      "priority": 100
    },
    {
      "rule_id": "pii.id_card.official_task",
